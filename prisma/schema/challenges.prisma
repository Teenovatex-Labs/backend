// Admin-created challenges with submissions, judging and winners. The automatic daily quests and weekly
// goals are separate and untouched.

enum ChallengeKind {
  weekly
  monthly
  special
}

enum ChallengeStatus {
  draft
  open
  judging
  closed
}

enum ChallengeEntryStatus {
  submitted
  withdrawn
  disqualified
}

model Challenge {
  id                   String          @id @default(uuid())
  title                String
  description          String
  rules                String
  kind                 ChallengeKind   @default(special)
  starts_at            DateTime
  ends_at              DateTime
  judging_ends_at      DateTime
  status               ChallengeStatus @default(draft)
  // [{ "name": "Creativity", "weight": 2 }, ...]; each criterion is scored 0 to 10.
  criteria             Json
  badge_id             String?
  entry_limit          Int             @default(1)
  results_published_at DateTime?
  created_by           String?
  created_at           DateTime        @default(now())
  updated_at           DateTime        @updatedAt

  badge   BadgeDefinition?  @relation(fields: [badge_id], references: [id])
  entries ChallengeEntry[]
  results ChallengeResult[]
  awards  BadgeAward[]

  @@index([status])
  @@map("challenges")
}

model ChallengeEntry {
  id           String               @id @default(uuid())
  challenge_id String
  user_id      String
  title        String
  body         String
  links        Json                 @default("[]")
  status       ChallengeEntryStatus @default(submitted)
  dq_reason    String?
  submitted_at DateTime             @default(now())
  updated_at   DateTime             @updatedAt

  challenge Challenge         @relation(fields: [challenge_id], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [user_id], references: [id], onDelete: Cascade)
  scores    ChallengeScore[]
  results   ChallengeResult[]

  @@index([challenge_id, user_id])
  @@map("challenge_entries")
}

model ChallengeScore {
  id         String   @id @default(uuid())
  entry_id   String
  judge_id   String
  // { "Creativity": 8, ... } keyed by criterion name.
  scores     Json
  // Weighted average on a 0 to 10 scale, stored in hundredths (850 = 8.5).
  total      Int
  note       String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  entry ChallengeEntry @relation(fields: [entry_id], references: [id], onDelete: Cascade)

  @@unique([entry_id, judge_id])
  @@map("challenge_scores")
}

model ChallengeResult {
  id           String   @id @default(uuid())
  challenge_id String
  entry_id     String
  user_id      String
  // Tied entries share a place (1, 1, 3).
  place        Int
  // Average of the judges' totals, in hundredths.
  total        Int
  published_at DateTime @default(now())

  challenge Challenge      @relation(fields: [challenge_id], references: [id], onDelete: Cascade)
  entry     ChallengeEntry @relation(fields: [entry_id], references: [id], onDelete: Cascade)

  @@unique([challenge_id, entry_id])
  @@map("challenge_results")
}
