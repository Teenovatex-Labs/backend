// Events are created by moderators and admins; members RSVP.
model Event {
  id          String    @id @default(uuid())
  title       String
  description String
  starts_at   DateTime
  ends_at     DateTime?
  // Where it happens: a meeting link for online events, or a place.
  location    String?
  cover_url   String?
  capacity    Int?
  created_by  String?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  rsvps EventRsvp[]

  @@index([starts_at])
  @@map("events")
}

model EventRsvp {
  event_id    String
  user_id     String
  created_at  DateTime  @default(now())
  reminded_at DateTime?

  event Event @relation(fields: [event_id], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([event_id, user_id])
  @@map("event_rsvps")
}
