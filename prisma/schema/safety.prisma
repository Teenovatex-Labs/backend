enum ReportTarget {
  post
  comment
  lab
  user
  message
}

enum ReportReason {
  bullying
  inappropriate
  spam
  personal_info
  self_harm
  unsafe_contact
  other
}

enum ReportStatus {
  open
  actioned
  dismissed
}

model Report {
  id             String       @id @default(uuid())
  reporter_id    String
  target_type    ReportTarget
  target_id      String
  // Who the report is about, so repeat offenders show up without joining across content types.
  target_user_id String?
  reason         ReportReason
  details        String?
  status         ReportStatus @default(open)
  handled_by     String?
  handled_at     DateTime?
  note           String?
  created_at     DateTime     @default(now())

  reporter User @relation("reporter", fields: [reporter_id], references: [id], onDelete: Cascade)

  @@unique([reporter_id, target_type, target_id])
  @@index([status, created_at])
  @@index([target_user_id])
  @@map("reports")
}

model Block {
  blocker_id String
  blocked_id String
  created_at DateTime @default(now())

  blocker User @relation("blocker", fields: [blocker_id], references: [id], onDelete: Cascade)
  blocked User @relation("blocked", fields: [blocked_id], references: [id], onDelete: Cascade)

  @@id([blocker_id, blocked_id])
  @@map("blocks")
}

// Every moderator action leaves a line here. Nobody can edit or delete these through the API.
model AuditLog {
  id          String   @id @default(uuid())
  actor_id    String?
  action      String
  target_type String?
  target_id   String?
  meta        Json?
  created_at  DateTime @default(now())

  @@index([created_at])
  @@index([target_type, target_id])
  @@map("audit_logs")
}

enum AttachmentStatus {
  pending
  approved
  rejected
}

// An image sent in a lab team chat. Stored privately and only shown to the team once a moderator
// approves it. The file is re-encoded on upload, so it carries no location or camera data.
model MessageAttachment {
  id          String           @id @default(uuid())
  message_id  String           @unique
  uploader_id String
  public_id   String
  width       Int
  height      Int
  status      AttachmentStatus @default(pending)
  reviewed_by String?
  reviewed_at DateTime?
  // Set when a moderator rejects it as a serious safety matter: the file is kept (privately) as evidence.
  escalated   Boolean          @default(false)
  note        String?
  created_at  DateTime         @default(now())

  message  Message @relation(fields: [message_id], references: [id], onDelete: Cascade)
  uploader User    @relation(fields: [uploader_id], references: [id], onDelete: Cascade)

  @@index([status, created_at])
  @@index([uploader_id, created_at])
  @@map("message_attachments")
}
