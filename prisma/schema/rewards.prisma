// Why points were given or taken. The `reason` text is for people; this is for code.
enum PointsKind {
  vote_received
  vote_removed
  lesson
  streak
  streak_milestone
  post_tagged
  quest
  other
}

model PointsLog {
  id           String     @id @default(uuid())
  user_id      String
  // Hundredths of a point: 150 means 1.5. See src/lib/pointsMath.ts.
  points       Int
  reason       String
  kind         PointsKind @default(other)
  reference_id String?
  season_id    String?
  created_at   DateTime   @default(now())

  user   User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  season Season? @relation(fields: [season_id], references: [id])

  @@index([season_id])

  @@map("points_log")
}

model UserBadge {
  user_id    String
  key        String
  awarded_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([user_id, key])
  @@map("user_badges")
}

// One quest reward per member per (their own) day.
model QuestClaim {
  user_id    String
  day        DateTime @db.Date
  key        String
  claimed_at DateTime @default(now())

  @@id([user_id, day])
  @@map("quest_claims")
}

// One reward taken from a week's challenges (or the all-three bonus, key "bonus"). The key makes a
// double claim impossible.
model WeeklyClaim {
  user_id    String
  week       DateTime @db.Date // the Monday that starts the member's week
  key        String
  claimed_at DateTime @default(now())

  @@id([user_id, week, key])
  @@map("weekly_claims")
}

// High-rank honours: rare, manual and meaningful. Separate from the automatic activity badges (UserBadge).
enum BadgeTier {
  standard
  high
  top
}

enum BadgeImageKind {
  svg
  png
  webp
}

model BadgeDefinition {
  id            String          @id @default(uuid())
  slug          String          @unique
  name          String
  description   String
  tier          BadgeTier       @default(high)
  // Written criteria, shown on the badge detail dialog, so an honour is never a popularity contest.
  criteria_text String
  // Raster artwork lives in Cloudinary. SVG is stored sanitised here and served by our own route.
  image_kind    BadgeImageKind?
  image_url     String?
  svg_source    String?
  // PNG version for emails and notifications.
  fallback_url  String?
  active        Boolean         @default(true)
  repeatable    Boolean         @default(false)
  created_by    String?
  created_at    DateTime        @default(now())
  updated_at    DateTime        @updatedAt

  awards BadgeAward[]

  @@map("badge_definitions")
}

model BadgeAward {
  id            String    @id @default(uuid())
  user_id       String
  badge_id      String
  awarded_by    String
  reason        String
  // Set when a judged challenge awards it (added in the challenges work).
  challenge_id  String?
  awarded_at    DateTime  @default(now())
  revoked_at    DateTime?
  revoked_by    String?
  revoke_reason String?
  featured      Boolean   @default(false)

  user  User            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  badge BadgeDefinition @relation(fields: [badge_id], references: [id])

  @@index([user_id])
  @@index([badge_id])
  @@map("badge_awards")
}

// Points are counted per season. Season 0 holds everything earned before seasons existed (legacy).
model Season {
  id        String    @id @default(uuid())
  number    Int       @unique
  name      String
  starts_at DateTime  @default(now())
  ends_at   DateTime?
  is_current Boolean  @default(false)
  created_by String?

  totals SeasonTotal[]
  log    PointsLog[]

  @@map("seasons")
}

// Each member's final total for a finished season, in hundredths of a point.
model SeasonTotal {
  user_id   String
  season_id String
  points    Int

  user   User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  season Season @relation(fields: [season_id], references: [id])

  @@id([user_id, season_id])
  @@index([season_id])
  @@map("season_totals")
}
