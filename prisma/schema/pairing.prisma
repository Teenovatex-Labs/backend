// Admin-curated pairs and trios. Members never choose each other; the system only suggests.

enum PairingKind {
  pair
  trio
}

enum PairingStatus {
  proposed
  active
  closed
  cancelled
}

model Pairing {
  id                 String        @id @default(uuid())
  kind               PairingKind   @default(pair)
  goal               String
  rationale          String?
  status             PairingStatus @default(proposed)
  // A minor and an adult together. Needs a second admin, a written rationale, a supervisor and a cleared adult.
  supervised         Boolean       @default(false)
  supervisor_id      String?
  starts_on          DateTime?     @db.Date
  ends_on            DateTime      @db.Date
  created_by         String
  approved_by        String?
  second_approved_by String?
  closed_reason      String?
  created_at         DateTime      @default(now())
  updated_at         DateTime      @updatedAt

  members      PairingMember[]
  conversation Conversation?

  @@index([status])
  @@map("pairings")
}

model PairingMember {
  pairing_id String
  user_id    String

  pairing Pairing @relation(fields: [pairing_id], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([pairing_id, user_id])
  @@index([user_id])
  @@map("pairing_members")
}
