generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  member
  mentor
  moderator
  admin
}

model User {
  id            String    @id @default(uuid())
  username      String    @unique
  // False for Google sign-ups until the member picks their own handle (they get a placeholder).
  username_set  Boolean   @default(true)
  full_name     String
  email         String    @unique
  password_hash String?
  google_id     String?   @unique
  avatar_url    String?
  bio           String?
  social_links  Json?
  points        Int       @default(0)
  streak        Int       @default(0)
  last_login_at DateTime?

  // Age gate: members must be 13 or older. Only the date is stored (no time), and it is
  // never included in any public profile response.
  birth_date       DateTime? @db.Date
  // IANA name such as "Africa/Lagos"; drives "today" for streaks, votes and reminders.
  timezone         String?
  role             Role      @default(member)
  // A suspended member can still sign in and read, but cannot post, comment, vote or message.
  // Earned every 7-day streak (max 2). One is spent automatically to save a streak after a missed day.
  streak_freezes   Int       @default(0)
  suspended_until  DateTime?
  suspended_reason String?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  // Email verification — a 6-digit code sent via Resend at signup.
  // Google accounts skip this (Google already verified the address).
  email_verified               Boolean   @default(false)
  verification_code_hash       String?
  verification_code_expires_at DateTime?
  verification_attempts        Int       @default(0)

  // Password reset — a separate 6-digit code (+ fallback link, same as
  // signup) so a reset in progress never collides with signup verification.
  reset_code_hash       String?
  reset_code_expires_at DateTime?
  reset_attempts        Int       @default(0)

  projects        Project[]
  rsvps           EventRsvp[]
  posts           Post[]
  lab_memberships LabMember[]
  lab_requests    LabJoinRequest[]
  conversations   ConversationMember[]
  messages_sent   Message[]
  comments        Comment[]
  reactions       Reaction[]
  reports_made    Report[]             @relation("reporter")
  blocks_made     Block[]              @relation("blocker")
  blocked_by      Block[]              @relation("blocked")
  lessons_done    LessonProgress[]
  votes           Vote[]
  points_log      PointsLog[]
  notifications   Notification[]
  sessions        Session[]
  settings        UserSettings?
  following       Follow[]             @relation("follower")
  followers       Follow[]             @relation("following")
  userBadges      UserBadge[]
  petActions      PetAction[]
  petMemories     PetMemory[]

  @@map("users")
}

model Project {
  id                String   @id @default(uuid())
  user_id           String
  name              String
  slug              String   @unique
  short_description String
  description       String
  category          String
  cover_url         String?
  demo_url          String?
  github_url        String?
  tx_post_url       String?
  tags              String[]
  vote_count        Int      @default(0)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  user          User             @relation(fields: [user_id], references: [id], onDelete: Cascade)
  votes         Vote[]
  updates       LabUpdate[]
  tasks         LabTask[]
  milestones    LabMilestone[]
  members       LabMember[]
  join_requests LabJoinRequest[]
  chat          Conversation?

  @@map("projects")
}

model Vote {
  id         String   @id @default(uuid())
  user_id    String
  project_id String
  voted_at   DateTime @default(now())
  // The voter's own calendar day. With the unique key below it makes "one vote per project
  // per day" a database guarantee, so a double-click or two tabs can't slip a second one in.
  vote_day   DateTime @db.Date

  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@unique([user_id, project_id, vote_day])
  @@map("votes")
}

// Why points were given or taken. The `reason` text is for people; this is for code.
enum PointsKind {
  vote_received
  vote_removed
  lesson
  streak
  streak_milestone
  post_tagged
  quest
  other
}

model PointsLog {
  id           String     @id @default(uuid())
  user_id      String
  points       Int
  reason       String
  kind         PointsKind @default(other)
  reference_id String?
  created_at   DateTime   @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("points_log")
}

model Notification {
  id         String   @id @default(uuid())
  user_id    String
  type       String
  message    String
  // Where tapping the notification goes, e.g. "/labs/my-lab", and any extra data for the pet.
  link       String?
  payload    Json?
  read       Boolean  @default(false)
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model Session {
  id              String    @id @default(uuid())
  user_id         String
  token_hash      String    @unique
  // The token this one replaced, kept briefly so two tabs refreshing at the same moment don't clash.
  prev_token_hash String?   @unique
  // How many times this session's refresh token has been replaced. Together with the session id it
  // lets the server re-create the current token exactly, so a lost response or a second tab is safe.
  rotation        Int       @default(0)
  rotated_at      DateTime?
  device_info     String?
  ip              String?
  last_active     DateTime  @default(now())
  created_at      DateTime  @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Follow {
  follower_id  String
  following_id String
  created_at   DateTime @default(now())

  follower  User @relation("follower", fields: [follower_id], references: [id], onDelete: Cascade)
  following User @relation("following", fields: [following_id], references: [id], onDelete: Cascade)

  @@id([follower_id, following_id])
  @@map("follows")
}

model UserSettings {
  user_id             String    @id
  email_notifications Boolean   @default(true)
  vote_alerts         Boolean   @default(true)
  contest_updates     Boolean   @default(true)
  public_profile      Boolean   @default(true)
  // Alfred's AI brain sends what you type to Alfred to Google or Groq. Off until the member opts in.
  ai_chat             Boolean   @default(false)
  ai_consented_at     DateTime?

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("settings")
}

// Events are created by moderators and admins; members RSVP.
model Event {
  id          String    @id @default(uuid())
  title       String
  description String
  starts_at   DateTime
  ends_at     DateTime?
  // Where it happens: a meeting link for online events, or a place.
  location    String?
  cover_url   String?
  capacity    Int?
  created_by  String?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  rsvps EventRsvp[]

  @@index([starts_at])
  @@map("events")
}

model EventRsvp {
  event_id    String
  user_id     String
  created_at  DateTime  @default(now())
  reminded_at DateTime?

  event Event @relation(fields: [event_id], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([event_id, user_id])
  @@map("event_rsvps")
}

// Learn: short, curated tracks written by the team. Members can't add lessons.
model Track {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  description String
  position    Int      @default(0)
  published   Boolean  @default(true)
  created_at  DateTime @default(now())

  lessons Lesson[]

  @@map("tracks")
}

model Lesson {
  id       String @id @default(uuid())
  track_id String
  slug     String
  title    String
  summary  String
  // Plain text with light formatting: "## Heading", "- bullet", blank line between paragraphs.
  body     String
  minutes  Int    @default(5)
  position Int    @default(0)

  track    Track            @relation(fields: [track_id], references: [id], onDelete: Cascade)
  progress LessonProgress[]

  @@unique([track_id, slug])
  @@map("lessons")
}

model LessonProgress {
  user_id      String
  lesson_id    String
  completed_at DateTime @default(now())

  user   User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lesson_id], references: [id], onDelete: Cascade)

  @@id([user_id, lesson_id])
  @@map("lesson_progress")
}

// ---------------------------------------------------------------------------------------------
// Trust and safety

enum ReportTarget {
  post
  comment
  lab
  user
  message
}

enum ReportReason {
  bullying
  inappropriate
  spam
  personal_info
  self_harm
  unsafe_contact
  other
}

enum ReportStatus {
  open
  actioned
  dismissed
}

model Report {
  id             String       @id @default(uuid())
  reporter_id    String
  target_type    ReportTarget
  target_id      String
  // Who the report is about, so repeat offenders show up without joining across content types.
  target_user_id String?
  reason         ReportReason
  details        String?
  status         ReportStatus @default(open)
  handled_by     String?
  handled_at     DateTime?
  note           String?
  created_at     DateTime     @default(now())

  reporter User @relation("reporter", fields: [reporter_id], references: [id], onDelete: Cascade)

  @@unique([reporter_id, target_type, target_id])
  @@index([status, created_at])
  @@index([target_user_id])
  @@map("reports")
}

model Block {
  blocker_id String
  blocked_id String
  created_at DateTime @default(now())

  blocker User @relation("blocker", fields: [blocker_id], references: [id], onDelete: Cascade)
  blocked User @relation("blocked", fields: [blocked_id], references: [id], onDelete: Cascade)

  @@id([blocker_id, blocked_id])
  @@map("blocks")
}

// Every moderator action leaves a line here. Nobody can edit or delete these through the API.
model AuditLog {
  id          String   @id @default(uuid())
  actor_id    String?
  action      String
  target_type String?
  target_id   String?
  meta        Json?
  created_at  DateTime @default(now())

  @@index([created_at])
  @@index([target_type, target_id])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------------------------
// Community

model Space {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  description String
  position    Int      @default(0)
  created_at  DateTime @default(now())

  posts Post[]

  @@map("spaces")
}

model Post {
  id             String   @id @default(uuid())
  space_id       String
  author_id      String
  title          String
  body           String
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
  // Soft removal: hidden posts stay for moderators and the audit trail but never show to members.
  hidden         Boolean  @default(false)
  comment_count  Int      @default(0)
  reaction_count Int      @default(0)

  space     Space      @relation(fields: [space_id], references: [id], onDelete: Cascade)
  author    User       @relation(fields: [author_id], references: [id], onDelete: Cascade)
  comments  Comment[]
  reactions Reaction[]

  @@index([space_id, created_at])
  @@index([author_id])
  @@map("posts")
}

model Comment {
  id         String   @id @default(uuid())
  post_id    String
  author_id  String
  body       String
  created_at DateTime @default(now())
  hidden     Boolean  @default(false)

  post   Post @relation(fields: [post_id], references: [id], onDelete: Cascade)
  author User @relation(fields: [author_id], references: [id], onDelete: Cascade)

  @@index([post_id, created_at])
  @@map("comments")
}

model Reaction {
  user_id    String
  post_id    String
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  post Post @relation(fields: [post_id], references: [id], onDelete: Cascade)

  @@id([user_id, post_id])
  @@map("reactions")
}

// ---------------------------------------------------------------------------------------------
// Messages. One-to-one for now. You can only message someone you follow and who follows you back.

model Conversation {
  id         String   @id @default(uuid())
  // The two member ids, sorted and joined, so a pair can only ever have one conversation.
  pair_key   String?  @unique
  // Set for a lab team's shared chat (and then pair_key is empty); one chat per lab.
  lab_id     String?  @unique
  created_at DateTime @default(now())
  updated_at DateTime @default(now())

  lab      Project?             @relation(fields: [lab_id], references: [id], onDelete: Cascade)
  members  ConversationMember[]
  messages Message[]

  @@map("conversations")
}

model ConversationMember {
  conversation_id String
  user_id         String
  last_read_at    DateTime @default(now())

  conversation Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([conversation_id, user_id])
  @@index([user_id])
  @@map("conversation_members")
}

model Message {
  id              String   @id @default(uuid())
  conversation_id String
  sender_id       String
  body            String
  created_at      DateTime @default(now())
  // Hidden by the sender (unsend) or by a moderator. Kept for the audit trail, never shown to members.
  hidden          Boolean  @default(false)

  conversation Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [sender_id], references: [id], onDelete: Cascade)

  @@index([conversation_id, created_at])
  @@map("messages")
}

// ---------------------------------------------------------------------------------------------
// Labs, deeper: build log, planning board, milestones and teams.

model LabUpdate {
  id         String   @id @default(uuid())
  lab_id     String
  author_id  String
  title      String
  body       String
  created_at DateTime @default(now())

  lab Project @relation(fields: [lab_id], references: [id], onDelete: Cascade)

  @@index([lab_id, created_at])
  @@map("lab_updates")
}

enum TaskStatus {
  backlog
  in_progress
  testing
  done
}

model LabTask {
  id          String     @id @default(uuid())
  lab_id      String
  title       String
  notes       String?
  status      TaskStatus @default(backlog)
  position    Int        @default(0)
  assignee_id String?
  due_at      DateTime?
  reminded_at DateTime?
  created_by  String
  created_at  DateTime   @default(now())
  done_at     DateTime?

  lab Project @relation(fields: [lab_id], references: [id], onDelete: Cascade)

  @@index([lab_id, status, position])
  @@index([due_at])
  @@map("lab_tasks")
}

model LabMilestone {
  id          String    @id @default(uuid())
  lab_id      String
  title       String
  due_at      DateTime?
  done_at     DateTime?
  reminded_at DateTime?
  created_at  DateTime  @default(now())

  lab Project @relation(fields: [lab_id], references: [id], onDelete: Cascade)

  @@index([lab_id])
  @@index([due_at])
  @@map("lab_milestones")
}

enum LabRole {
  owner
  member
}

model LabMember {
  lab_id     String
  user_id    String
  role       LabRole  @default(member)
  created_at DateTime @default(now())

  lab  Project @relation(fields: [lab_id], references: [id], onDelete: Cascade)
  user User    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([lab_id, user_id])
  @@index([user_id])
  @@map("lab_members")
}

enum JoinStatus {
  pending
  accepted
  declined
}

model LabJoinRequest {
  id         String     @id @default(uuid())
  lab_id     String
  user_id    String
  message    String?
  status     JoinStatus @default(pending)
  created_at DateTime   @default(now())

  lab  Project @relation(fields: [lab_id], references: [id], onDelete: Cascade)
  user User    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([lab_id, user_id])
  @@map("lab_join_requests")
}

// How many times each member used Alfred's AI brain each day. No message content is stored.
model PetUsage {
  user_id String
  day     DateTime @db.Date
  count   Int      @default(0)

  @@id([user_id, day])
  @@map("pet_usage")
}

// Team news shown as a banner across the app. Created by moderators and admins.
model Announcement {
  id         String    @id @default(uuid())
  title      String
  body       String
  link       String?
  created_by String?
  created_at DateTime  @default(now())
  expires_at DateTime?

  @@index([created_at])
  @@map("announcements")
}

// ---------------------------------------------------------------------------------------------
// Rewards: badges and the daily quest.

model UserBadge {
  user_id    String
  key        String
  awarded_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([user_id, key])
  @@map("user_badges")
}

// One quest reward per member per (their own) day.
model QuestClaim {
  user_id    String
  day        DateTime @db.Date
  key        String
  claimed_at DateTime @default(now())

  @@id([user_id, day])
  @@map("quest_claims")
}

// Everything Alfred did for a member on their say-so, so they can see it and (for a while) undo it.
model PetAction {
  id         String    @id @default(uuid())
  user_id    String
  kind       String
  summary    String
  // What is needed to undo it (a username, a lab id, notification ids). Never message content.
  payload    Json?
  undone_at  DateTime?
  created_at DateTime  @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, created_at])
  @@map("pet_actions")
}

// Short things a member asked Alfred to remember ("I hate gradients"). Visible and deletable by them.
model PetMemory {
  id         String   @id @default(uuid())
  user_id    String
  text       String
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, created_at])
  @@map("pet_memories")
}
