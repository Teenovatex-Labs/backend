generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  member
  mentor
  moderator
  admin
}

model User {
  id            String    @id @default(uuid())
  username      String    @unique
  // False for Google sign-ups until the member picks their own handle (they get a placeholder).
  username_set  Boolean   @default(true)
  full_name     String
  email         String    @unique
  password_hash String?
  google_id     String?   @unique
  avatar_url    String?
  bio           String?
  social_links  Json?
  points        Int       @default(0)
  streak        Int       @default(0)
  last_login_at DateTime?

  // Age gate: members must be 13 or older. Only the date is stored (no time), and it is
  // never included in any public profile response.
  birth_date DateTime? @db.Date
  // IANA name such as "Africa/Lagos"; drives "today" for streaks, votes and reminders.
  timezone   String?
  role       Role      @default(member)
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  // Email verification — a 6-digit code sent via Resend at signup.
  // Google accounts skip this (Google already verified the address).
  email_verified               Boolean   @default(false)
  verification_code_hash       String?
  verification_code_expires_at DateTime?
  verification_attempts        Int       @default(0)

  // Password reset — a separate 6-digit code (+ fallback link, same as
  // signup) so a reset in progress never collides with signup verification.
  reset_code_hash       String?
  reset_code_expires_at DateTime?
  reset_attempts        Int       @default(0)

  projects      Project[]
  rsvps         EventRsvp[]
  lessons_done  LessonProgress[]
  votes         Vote[]
  points_log    PointsLog[]
  notifications Notification[]
  sessions      Session[]
  settings      UserSettings?
  following     Follow[]       @relation("follower")
  followers     Follow[]       @relation("following")

  @@map("users")
}

model Project {
  id                String   @id @default(uuid())
  user_id           String
  name              String
  slug              String   @unique
  short_description String
  description       String
  category          String
  cover_url         String?
  demo_url          String?
  github_url        String?
  tx_post_url       String?
  tags              String[]
  vote_count        Int      @default(0)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  user  User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  votes Vote[]

  @@map("projects")
}

model Vote {
  id         String   @id @default(uuid())
  user_id    String
  project_id String
  voted_at   DateTime @default(now())
  // The voter's own calendar day. With the unique key below it makes "one vote per project
  // per day" a database guarantee, so a double-click or two tabs can't slip a second one in.
  vote_day   DateTime @db.Date

  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@unique([user_id, project_id, vote_day])
  @@map("votes")
}

model PointsLog {
  id           String   @id @default(uuid())
  user_id      String
  points       Int
  reason       String
  reference_id String?
  created_at   DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("points_log")
}

model Notification {
  id         String   @id @default(uuid())
  user_id    String
  type       String
  message    String
  // Where tapping the notification goes, e.g. "/labs/my-lab", and any extra data for the pet.
  link       String?
  payload    Json?
  read       Boolean  @default(false)
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model Session {
  id          String   @id @default(uuid())
  user_id     String
  token_hash  String   @unique
  device_info String?
  ip          String?
  last_active DateTime @default(now())
  created_at  DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Follow {
  follower_id  String
  following_id String
  created_at   DateTime @default(now())

  follower  User @relation("follower", fields: [follower_id], references: [id], onDelete: Cascade)
  following User @relation("following", fields: [following_id], references: [id], onDelete: Cascade)

  @@id([follower_id, following_id])
  @@map("follows")
}

model UserSettings {
  user_id             String  @id
  email_notifications Boolean @default(true)
  vote_alerts         Boolean @default(true)
  contest_updates     Boolean @default(true)
  public_profile      Boolean @default(true)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("settings")
}

// Events are created by moderators and admins; members RSVP.
model Event {
  id          String   @id @default(uuid())
  title       String
  description String
  starts_at   DateTime
  ends_at     DateTime?
  // Where it happens: a meeting link for online events, or a place.
  location    String?
  cover_url   String?
  capacity    Int?
  created_by  String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  rsvps EventRsvp[]

  @@index([starts_at])
  @@map("events")
}

model EventRsvp {
  event_id   String
  user_id    String
  created_at DateTime @default(now())

  event Event @relation(fields: [event_id], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([event_id, user_id])
  @@map("event_rsvps")
}

// Learn: short, curated tracks written by the team. Members can't add lessons.
model Track {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  description String
  position    Int      @default(0)
  published   Boolean  @default(true)
  created_at  DateTime @default(now())

  lessons Lesson[]

  @@map("tracks")
}

model Lesson {
  id       String  @id @default(uuid())
  track_id String
  slug     String
  title    String
  summary  String
  // Plain text with light formatting: "## Heading", "- bullet", blank line between paragraphs.
  body     String
  minutes  Int     @default(5)
  position Int     @default(0)

  track    Track            @relation(fields: [track_id], references: [id], onDelete: Cascade)
  progress LessonProgress[]

  @@unique([track_id, slug])
  @@map("lessons")
}

model LessonProgress {
  user_id      String
  lesson_id    String
  completed_at DateTime @default(now())

  user   User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lesson_id], references: [id], onDelete: Cascade)

  @@id([user_id, lesson_id])
  @@map("lesson_progress")
}
