# PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/tx_db"

# JWT — generate strong secrets: openssl rand -base64 64
JWT_SECRET="your-access-token-secret"
JWT_REFRESH_SECRET="your-refresh-token-secret"

# App
PORT=3000
NODE_ENV=development
FRONTEND_URL="http://localhost:5173"

# Cloudinary (required for image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Gmail SMTP — port 465 SSL (leave blank to log reset links to console in dev)
# App Password setup: https://myaccount.google.com/apppasswords
# (requires 2-Step Verification enabled on the Gmail account)
GMAIL_USER="youremail@gmail.com"
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"

# Contest config (used by GET /api/v1/admin/stats)
CONTEST_STATUS=active
CONTEST_ENDS_AT=2026-06-30T23:59:59Z
