# PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/tx_db"

# JWT — generate strong secrets: openssl rand -base64 64
JWT_SECRET="your-access-token-secret"
JWT_REFRESH_SECRET="your-refresh-token-secret"

# Google Sign-In — Client ID from Google Cloud Console (OAuth consent screen + credentials)
# No client secret needed: the frontend gets an ID token via Google Identity Services,
# and this backend verifies it directly against this Client ID.
GOOGLE_CLIENT_ID=

# App
PORT=4000
NODE_ENV=development
# Comma-separated list of origins allowed by CORS. Production:
#   https://teenovatex.org,https://www.teenovatex.org,https://app.teenovatex.org
FRONTEND_URL="http://localhost:3000"
# Single origins used to build links/images inside emails (default to production).
SITE_URL="http://localhost:3000"
APP_URL="http://localhost:3000"
# Inbox that receives contact-form messages (needs RESEND_API_KEY to actually send).
CONTACT_TO=

# Cloudinary (required for image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Gmail SMTP — port 465 SSL (leave blank to log reset links to console in dev)
# App Password setup: https://myaccount.google.com/apppasswords
# (requires 2-Step Verification enabled on the Gmail account)
GMAIL_USER="youremail@gmail.com"
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"

# Resend — signup email-verification codes (leave blank to log codes to console in dev)
# Get a key at https://resend.com/api-keys. RESEND_FROM must be an address on
# a domain verified in Resend, or omit it to use Resend's sandbox sender.
RESEND_API_KEY=
RESEND_FROM="TeenovateX Labs <onboarding@resend.dev>"

# Alfred's AI brain (free tiers). Comma-separated keys; a spare key takes over when one is rate-limited.
GEMINI_API_KEYS=
GROQ_API_KEYS=
GEMINI_MODEL=gemini-flash-lite-latest
GROQ_MODEL=openai/gpt-oss-20b
PET_PROVIDER_ORDER=gemini,groq
PET_DAILY_LIMIT=40
PET_AI_ENABLED=true

# Emails that become admin automatically once verified (comma-separated).
ADMIN_EMAILS=

# Error alerts (optional). Create a Sentry project and paste its DSN. Nothing personal is sent.
# SENTRY_DSN=
